<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>Jared Goodwin</Authors>
    <Copyright>©️ $([System.DateTime]::Now.Year) Bitbound</Copyright>
    <RepositoryUrl>https://github.com/bitbound/image-edit-mcp.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bitbound/image-edit-mcp</PackageProjectUrl>
    <Company>Bitbound</Company>
    <Description>Open-source MCP server for image editing with SkiaSharp.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);S125;NU1608;</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);BB0001;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
