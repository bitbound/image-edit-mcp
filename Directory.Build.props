<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>Jared Goodwin</Authors>
    <Copyright>©️ $([System.DateTime]::Now.Year) Bitbound</Copyright>
    <RepositoryUrl>https://github.com/bitbound/image-edit-mcp.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bitbound/image-edit-mcp</PackageProjectUrl>
    <Company>Bitbound</Company>
    <Description>A Model Context Protocol (MCP) server that exposes SkiaSharp-powered image editing tools over stdio. Load an image, apply edits on a local working copy, inspect the result, and save to a new file.</Description>
    <PackageTags>mcp model-context-protocol image editing skia ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);S125;NU1608;</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);BB0001;</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
